# ===== AI Provider（四選一或多選，至少設定一組）=====
# 設定多組時，App 內 ⚙️ 設定可切換；AI_PROVIDER 指定預設（anthropic | gpt | gemini | custom）
AI_PROVIDER=anthropic

# 1) Claude (Anthropic) — https://platform.claude.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# 2) GPT (OpenAI) — https://platform.openai.com
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# 3) Gemini (Google) — https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 4) 自訂 Endpoint（OpenAI 相容 /v1/chat/completions，例如手機/本機部署的 Gemma）
# CUSTOM_BASE_URL=http://192.168.x.x:8080/v1
# CUSTOM_MODEL=gemma-3-27b-it
# CUSTOM_API_KEY=
