# ===== AI Provider（四選一或多選，至少設定一組）=====
# 設定多組時，App 內 ⚙️ 設定可切換；AI_PROVIDER 指定預設（anthropic | gpt | gemini | custom）
AI_PROVIDER=anthropic

# 1) Claude (Anthropic) — https://platform.claude.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# 2) GPT (OpenAI) — https://platform.openai.com
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# 3) Gemini (Google) — https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 4) 自訂 Endpoint（OpenAI 相容 /v1/chat/completions，例如手機/本機部署的 Gemma）
# CUSTOM_BASE_URL=http://192.168.x.x:8080/v1
# CUSTOM_MODEL=gemma-3-27b-it
# CUSTOM_API_KEY=

# ===== 選用：Google Maps 相關（「🔍 找地址」與隨機推薦「📍 附近」模式）=====
# 設定後走 Google Places（Text Search / Nearby Search，結果最準、含評分）；
# 未設定則退回 OpenStreetMap（Nominatim / Overpass），免 key 但小店涵蓋率較差
# GOOGLE_MAPS_API_KEY=

# ===== 選用：Google Drive 雲端備份（App 內 ⚙️ →「☁️ 備份到雲端」）=====
# 開發者設定一次即可，使用者免任何設定（client ID 為公開值，可放前端）。
# 建立方式：Google Cloud Console → 建立 OAuth 2.0 用戶端 ID（Web 應用程式），
#   「已授權的 JavaScript 來源」加上部署網址（如 https://xxx.vercel.app 與 http://localhost:3000），
#   並在「OAuth 同意畫面」啟用 Google Drive API 與 drive.appdata scope。
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
