<?xml version="1.0" encoding="utf-8"?>
<!-- widget 新增／重新設定時選「這張卡片只抽哪個區域」 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_title"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_config_hint"
        android:textSize="12.5sp"
        android:textColor="?android:attr/textColorSecondary" />

    <ScrollView
        android:id="@+id/widget_config_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 第一層：縣市 -->
            <RadioGroup
                android:id="@+id/widget_config_regions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 第二層：行政區（選了有二級的縣市才出現） -->
            <TextView
                android:id="@+id/widget_config_district_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/celadon"
                android:visibility="gone" />

            <RadioGroup
                android:id="@+id/widget_config_districts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_config_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:background="@drawable/widget_btn_bg"
            android:textColor="@color/celadon"
            android:textStyle="bold"
            android:text="@string/widget_config_ok" />
    </LinearLayout>
</LinearLayout>
