<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_food_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- 骰子滾動動畫（換一家時顯示 2 秒，ViewFlipper 自動輪播骰面） -->
    <ViewFlipper
        android:id="@+id/widget_food_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="140"
        android:visibility="gone">

        <TextView style="@style/WidgetDiceFace" android:text="⚀" />
        <TextView style="@style/WidgetDiceFace" android:text="⚂" />
        <TextView style="@style/WidgetDiceFace" android:text="⚄" />
        <TextView style="@style/WidgetDiceFace" android:text="⚁" />
        <TextView style="@style/WidgetDiceFace" android:text="⚅" />
        <TextView style="@style/WidgetDiceFace" android:text="⚃" />
    </ViewFlipper>

    <!-- 標題列 + 內容／空狀態；換一家滾骰子時整塊隱藏 -->
    <LinearLayout
        android:id="@+id/widget_food_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/widget_food_title"
                android:textSize="11sp"
                android:textColor="#B45309"
                android:textStyle="bold" />

            <!-- 點區域標籤 → 開設定畫面換區域 -->
            <TextView
                android:id="@+id/widget_food_region"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#B45309" />
        </LinearLayout>

        <!-- 沒有資料時的空狀態（文字由 provider 依「完全沒收藏／這區沒收藏」帶入） -->
        <TextView
            android:id="@+id/widget_food_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_food_empty"
            android:textSize="13sp"
            android:textColor="#888888"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_food_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_food_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_food_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_food_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="11sp"
                android:textColor="#9CA3AF"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_food_shuffle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="@string/widget_food_shuffle"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#B45309" />

                <TextView
                    android:id="@+id/widget_food_maps"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="@string/widget_food_maps"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#B45309" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
